# Copia este archivo a `.env.local` y rellena lo que tengas.
# La app funciona sin ninguna variable: si falta NAN_KEY, todo se marca como
# "simulado". Nunca subas `.env.local` al repositorio.

# ─── NaN (Clef + extracción + rerank) ────────────────────────────────────────
# Clave de API de NaN. Sin ella: modo simulado y sin llamadas externas a Clef.
NAN_KEY=

# Evaluador de relevo. Jev (TypeSafe) habla el mismo protocolo que Clef, así
# que la app usa el primero que responda: si uno se retira, sigue con el otro
# en vez de caer al clasificador local. Clave en console.typesafe.ai
TYPESAFE_API_KEY=

# Origen usado SOLO por `npm run probe:nan` (el endpoint real de Clef está
# fijado en lib/config.ts). Sin valor: https://api.nan.builders
NAN_BASE_URL=https://api.nan.builders

# Extractor de claims con un modelo de chat de NaN. Vacío = extractor
# determinista local (recomendado si no hay catálogo de modelos a mano).
NAN_CHAT_MODEL=
NAN_CHAT_URL=https://api.nan.builders/v1/chat/completions

# Rerank opcional de evidencia. Si falta cualquiera de las dos o falla, se usa
# el ranker léxico local; el orden nunca depende de un solo proveedor.
NAN_RERANK_URL=
NAN_RERANK_MODEL=

# ─── Conectores de evidencia ─────────────────────────────────────────────────
# Metabuscador SearXNG autoalojado. Es la mejor opción medida y no necesita
# ninguna clave:
#   npm run search:up          arranca el contenedor en localhost:8099
#   VERIFYLIVE_SEARXNG_URL=http://localhost:8099
# Sobre ocho afirmaciones en español, con el reranker de NaN como juez, SearXNG
# encontró fuente relevante para las 8 (relevancia media 0,93) frente a 6 de 8
# y 0,66 del respaldo sin Docker. Vacío = desactivado, y la app sigue
# funcionando con el RSS de Bing Noticias.
VERIFYLIVE_SEARXNG_URL=
# Idioma y número de resultados que se le piden.
VERIFYLIVE_SEARXNG_LANGUAGE=es
VERIFYLIVE_SEARXNG_RESULTS=8

# Buscador web. Vacío = automático: SearXNG si está configurado, luego Google o
# Brave si hay clave, y si no `bingnews` (sin clave, solo prensa). Valores:
# searxng, google, brave, bingnews, bing, gdelt, none.
VERIFYLIVE_SEARCH_PROVIDER=

# Google Custom Search (100 consultas/día gratis). Ambas son necesarias.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Brave Search API (2.000 consultas/mes gratis).
BRAVE_SEARCH_API_KEY=

# Resultados pedidos al buscador por consulta (1-5). Por defecto: 3.
VERIFYLIVE_WEB_RESULTS=3

# API key de Jina Reader (opcional). Sin ella se usan Wikipedia y el corpus.
JINA_API_KEY=

# Wikipedia del lado servidor. Acepta 1/true/yes/on. Por defecto: true.
VERIFYLIVE_ENABLE_WIKIPEDIA=true

# Permite conectar con IPs privadas/loopback. Solo para desarrollo controlado:
# déjalo en false para mantener activa la protección SSRF.
VERIFYLIVE_ALLOW_PRIVATE_NETWORK=false

# ─── Almacenamiento ──────────────────────────────────────────────────────────
# SQLite gestionado con node:sqlite (requiere Node >= 22).
# Vacío = ~/.cache/verifylive/verifylive.sqlite. Si configuras una ruta relativa,
# se resuelve desde apps/web; para desarrollo conviene mantenerla fuera del repo.
VERIFYLIVE_DB=

# ─── Protección de la API pública ────────────────────────────────────────────
# Token opcional para los endpoints mutantes. Vacío mantiene el uso local sin
# login. En una demo pública usa un valor largo y entrégalo solo a participantes.
VERIFYLIVE_API_TOKEN=
# Confía en X-Forwarded-For/X-Real-IP solo detrás de un proxy que los sanee.
VERIFYLIVE_TRUST_PROXY=false
# Ventana y cuotas MVP en memoria (por proceso). Se aplican por ruta/IP y,
# cuando existe, también por sesión.
VERIFYLIVE_RATE_WINDOW_MS=60000
VERIFYLIVE_RATE_IP_LIMIT=120
VERIFYLIVE_RATE_SESSION_LIMIT=90
# Intentos de intercambio de token por IP cada 15 min como mínimo.
VERIFYLIVE_ACCESS_ATTEMPT_LIMIT=10

# ─── Cliente / navegador ─────────────────────────────────────────────────────
# Idioma del transcriptor (browser-whisper). Por defecto: es.
NEXT_PUBLIC_WHISPER_LANGUAGE=es
