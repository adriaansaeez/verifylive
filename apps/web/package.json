{
  "name": "verifylive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "probe:nan": "node --experimental-strip-types scripts/probe-nan.ts",
    "search:up": "docker compose -f search/docker-compose.yml up -d",
    "search:down": "docker compose -f search/docker-compose.yml down",
    "search:logs": "docker compose -f search/docker-compose.yml logs -f"
  },
  "dependencies": {
    "browser-whisper": "2.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
